<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: las sesiones cifradas y las cookies de inicio de sesión no viajan en copias ni transferencias. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="repisa_secure.xml" />
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="repisa_secure.xml" />
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
